   "compiled_code": "with tickets as (\n    select account_id, count(*) as n_tickets\n    from \"churn\".\"main_silver\".\"stg_tickets\"\n    where opened_on >= date '2026-04-01'\n    group by account_id\n)\nselect\n    a.account_id,\n    date_diff('month', a.opened_on, date '2026-06-30') as tenure_months,\n    case when a.plan_code in ('ent', 'enterprise') then 'enterprise' when a.plan_code = 'team' then 'team' else 'free' end as plan_tier,\n    coalesce(t.n_tickets, 0) as support_tickets_90d,\n    case when a.cancelled_on between date '2026-07-01' and date '2026-09-28' then 1 else 0 end as churned_90d\nfrom \"churn\".\"main_silver\".\"stg_accounts\" a\nleft join tickets t using (account_id)",
   "config": {
    "materialized": "table",
    "meta": {
     "mf": {
      "dataset": "accounts-2026",
      "keys": [
       "account_id"
      ],
      "label": "churned_90d"
     }
    },
    "tags": [
     "gold"
    ]
   },
